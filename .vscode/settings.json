{
    "[systemverilog]": {
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "editor.formatOnType": false,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
            "comments": "off",
            "other": "off",
            "strings": "off"
        },
        "editor.tabSize": 4
    },
    "DVT.contentFilters.enable": true,
    // "DVT.textEditor.formatting.maximumNumberOfLinesInFile": 10000,
    "DVT.textEditor.systemVerilog.formatting.indentation.addNewLineAfterBeginAndBeforeEnd": true,
    "DVT.textEditor.systemVerilog.formatting.indentation.addNewLineAfterEnd": true,
