    "DVT.textEditor.systemVerilog.formatting.verticalAlignment.verticalAlignSingleLineComments": false,
    // "DVT.textEditor.systemVerilog.formatting.verticalAlignment.verticalAlignTokens": [ // #TODO
    //     ":=",
    //     "<=",
    // ],
    "DVT.textEditor.systemVerilog.formatting.verticalAlignment.verticalAlignToOpenCurly": false, // default
    "DVT.textEditor.systemVerilog.formatting.verticalAlignment.verticalAlignToOpenParenthesis": false, // default
    "DVT.textEditor.systemVerilog.formatting.whitespace.addWhitespaceAfter": [
        // #TODO Does not work if list has more than one element??
        // "<=",
        "="
    ],
    "DVT.textEditor.systemVerilog.formatting.whitespace.addWhitespaceBefore": [
        // #TODO Does not work if list has more than one element??
        // "<=",
        "="
    ],
    "DVT.textEditor.systemVerilog.formatting.whitespace.compactConsecutiveEmptyLines": true,
    "DVT.textEditor.systemVerilog.formatting.whitespace.compactWhitespaceGroups": true,
    "DVT.textEditor.systemVerilog.formatting.whitespace.maximumNumberOfConsecutiveEmptyLines": 2,
    "DVT.textEditor.systemVerilog.formatting.whitespace.removeNewLineAfter": [
        "="
    ],
    "DVT.textEditor.systemVerilog.formatting.whitespace.removeNewLineBefore": [
        "=" // #TODO does not work as expected?
    ],
    "DVT.textEditor.systemVerilog.formatting.whitespace.trimEndOfLineWhitespace": true, // default
    "DVT.textEditor.systemVerilog.formatting.whitespace.trimWhitespaceLines": true, // default
