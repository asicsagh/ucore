    "DVT.textEditor.systemVerilog.formatting.indentation.indentMulti-lineAssigns": true, // default
    "DVT.textEditor.systemVerilog.formatting.indentation.indentMultiLineComments": true, // default
    "DVT.textEditor.systemVerilog.formatting.indentation.moreParametersPerLineIfLessThan": 3,
    "DVT.textEditor.systemVerilog.formatting.indentation.noIndentKeywords": {
        "assert": false,
        "assign": false,
        "assume": false,
        "case": false,
        "casex": false,
        "casez": false,
        "checker": false,
        "class": true,
        "clocking": false,
        "config": false,
        "cover": false,
        "covergroup": false,
        "fork": false,
        "function": false,
        "generate": false,
        "group": false,
        "interface": true,
        "macromodule": false,
        "module": true,
        "package": true,
        "primitive": false,
        "program": true,
        "property": false,
        "randcase": false,
        "randsequence": false,
        "sequence": false,
        "specify": false,
        "table": false,
        "task": false
    },
    // "DVT.textEditor.systemVerilog.formatting.indentation.openScopeMacros": [], // #TODO
    "DVT.textEditor.systemVerilog.formatting.indentation.optionalBegin": "On the same line", // DO NOT USE THIS? buggy?
    "DVT.textEditor.systemVerilog.formatting.indentation.parameters": "One per line (open parenthesis on the same line)",
    // "DVT.textEditor.systemVerilog.formatting.indentation.preprocessing": "Leave as is", // #TODO
    "DVT.textEditor.systemVerilog.formatting.lineWrapping.enableLineWrapping": true,
    "DVT.textEditor.systemVerilog.formatting.lineWrapping.lineWidth": 120,
    "DVT.textEditor.systemVerilog.formatting.lineWrapping.wrapMultiLineComments": true, // #TODO test it
    "DVT.textEditor.systemVerilog.formatting.lineWrapping.wrapSingleLineComments": true,
    "DVT.textEditor.systemVerilog.formatting.verticalAlignment.compactWhitespaceForVerticalAlignPatterns": true,
    "DVT.textEditor.systemVerilog.formatting.verticalAlignment.enableVerticalAlignment": false,
    // "DVT.textEditor.systemVerilog.formatting.verticalAlignment.independentPreprocessingScopes": false, // #TODO
    "DVT.textEditor.systemVerilog.formatting.verticalAlignment.onlyConsecutiveLines": true,
    "DVT.textEditor.systemVerilog.formatting.verticalAlignment.verticalAlignPatterns": {
        // "`defines": true,
        // "`xvm_field macros": false, #TODO
        // "By Name Port Connections": true, // #TODO reconsider
